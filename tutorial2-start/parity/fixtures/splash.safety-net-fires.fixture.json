{
  "description": "The splash arms a safety net when it appears and completes by whichever path gets there first: the animation ending, or the net firing. Both paths notify the host every time; a repeat Appeared is inert.",
  "dialect": 2,
  "feature": "splash",
  "initialState": {
    "isArmed": false
  },
  "scenario": {
    "branch": "safety-net-fires",
    "source": "src-kmp/subtrees/splash/logic/src/jvmTest/kotlin/dev/modaal/foyer/splash/SplashScenarioTest.kt"
  },
  "steps": [
    {
      "action": {
        "case": "appeared"
      },
      "expectedEffects": [
        {
          "id": "splash.safetyNet",
          "kind": "run",
          "payload": {
            "case": "armSafetyNet",
            "value": {
              "afterMillis": 3000
            }
          }
        }
      ],
      "expectedState": {
        "isArmed": true
      },
      "label": "the splash appears",
      "line": 33
    },
    {
      "action": {
        "case": "safetyNetElapsed"
      },
      "expectedEffects": [
        {
          "kind": "run",
          "payload": {
            "case": "notifyHost",
            "value": {
              "case": "completed",
              "value": {
                "path": {
                  "case": "safetyNet"
                }
              }
            }
          }
        }
      ],
      "expectedState": {
        "isArmed": true
      },
      "label": "safety net fires › the armed delay elapses instead",
      "line": 52
    }
  ]
